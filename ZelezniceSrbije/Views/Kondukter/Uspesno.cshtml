@{
    ViewData["Title"] = "Očitavanje uspesno";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm border-success mx-auto" style="max-width: 500px;">
        <div class="card-body p-5">
            <h1 class="display-1 text-success mb-3"><i class="bi bi-check-circle-fill"></i></h1>
            <h2 class="card-title text-success mb-4">Uspešno očitano!</h2>
            <p class="card-text fs-5">Ova karta je validna za trenutnu vožnju i uspesno je poništena.</p>
            <div class="mt-4">
                <a asp-controller="Kondukter" asp-action="Panel" class="btn btn-sz-primary btn-lg w-100">Nazad na panel</a>
            </div>
        </div>
    </div>
</div>