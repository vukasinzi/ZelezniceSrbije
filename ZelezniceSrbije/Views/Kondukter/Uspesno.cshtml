@{
    ViewData["Title"] = "Očitavanje uspesno";
}

<style>
    :root {
        --sz-red: #CC0000;
        --sz-blue: #003B8E;
    }

    .result-wrap {
        max-width: 560px;
        margin: 2.5rem auto;
    }

    .result-card {
        border: 1px solid #dbe4f0;
        border-radius: 14px;
        overflow: hidden;
    }

    .result-body {
        padding: 2rem 1.35rem 1.4rem;
        text-align: center;
    }

    .result-state {
        display: inline-block;
        background: #e6f0ff;
        color: var(--sz-blue);
        border-radius: 999px;
        padding: .35rem .8rem;
        font-size: .82rem;
        font-weight: 600;
        margin-bottom: .9rem;
    }

    .result-title {
        color: var(--sz-blue);
        margin-bottom: .65rem;
    }

    .btn-sz-primary {
        background: var(--sz-red);
        border: 1px solid var(--sz-red);
        color: #fff;
        font-weight: 600;
    }

    .btn-sz-primary:hover {
        background: #ad0000;
        border-color: #ad0000;
        color: #fff;
    }
</style>

<div class="result-wrap">
    <div class="card result-card shadow-sm">
        <div class="result-body">
            <span class="result-state">Uspešno</span>
            <h2 class="result-title h3">Karta je očitana</h2>
            <p class="text-muted fs-5">Ova karta je validna za trenutnu vožnju i uspešno je poništena.</p>
            <div class="mt-4">
                <a asp-controller="Kondukter" asp-action="Panel" class="btn btn-sz-primary btn-lg w-100">Nazad na panel</a>
            </div>
        </div>
    </div>
</div>
