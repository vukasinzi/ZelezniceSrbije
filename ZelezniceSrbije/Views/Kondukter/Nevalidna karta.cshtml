@{
    ViewData["Title"] = "Nevalidna karta";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm border-danger mx-auto" style="max-width: 500px;">
        <div class="card-body p-5">
            <h1 class="display-1 text-danger mb-3"><i class="bi bi-x-circle-fill"></i></h1>
            <h2 class="card-title text-danger mb-4">Nevalidna karta!</h2>
            <p class="card-text fs-5">Ova karta nije validna za trenutnu vožnju, ili je već poništena.</p>
            <div class="mt-4">
                <a asp-controller="Kondukter" asp-action="Panel" class="btn btn-sz-outline btn-lg w-100">Nazad na panel</a>
            </div>
        </div>
    </div>
</div>